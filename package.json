{
  "name": "conexao-perfumaria",
  "version": "0.1.0",
  "private": true,
  "description": "Loja independente da Conexao Perfumaria em Next.js e TypeScript.",
  "type": "module",
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs'); ['.next','coverage','dist'].forEach((path)=>fs.rmSync(path,{recursive:true,force:true}))\"",
    "dev": "next dev",
    "import:nuvemshop": "tsx scripts/import-nuvemshop.ts",
    "import:supabase": "tsx scripts/import-products-to-supabase.ts",
    "migrate:supabase": "tsx scripts/apply-supabase-migration.ts",
    "prebuild": "npm run lint",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "prettier": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.1",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "pg": "^8.21.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  },
  "volta": {
    "node": "24.14.0",
    "npm": "11.9.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
